logs/
*.log
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# --- macOS ---
.DS_Store

# --- VS Code (local settings stay local; shared recommendations may be committed) ---
.vscode/*
!.vscode/extensions.json
*.code-workspace
